# ── Vitis HLS generated artifacts ────────────────────────────────────────────
# Keep only solution1/syn/report/ (synthesis reports, essential for grading).
# Everything else under flash_attention_proj/ is regenerated by:
#   vitis_hls -f code/run_hls.tcl

code/flash_attention_proj/*
!code/flash_attention_proj/hls.app
!code/flash_attention_proj/solution1
code/flash_attention_proj/solution1/*
!code/flash_attention_proj/solution1/syn
code/flash_attention_proj/solution1/syn/*
!code/flash_attention_proj/solution1/syn/report

code/vitis_hls.log

# ── macOS metadata ────────────────────────────────────────────────────────────
.DS_Store

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── LaTeX build artifacts ─────────────────────────────────────────────────────
examples/*.aux
examples/*.log
examples/*.out
examples/*.toc
examples/*.snm
examples/*.nav
examples/*.vrb
examples/*.synctex.gz
